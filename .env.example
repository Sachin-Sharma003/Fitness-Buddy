# ============================================================
#  Fitness Buddy — Environment Configuration Template
#  Copy this file to .env and fill in your real values.
#  NEVER commit your actual .env file to version control.
# ============================================================

# IBM Cloud API Key
# Get from: https://cloud.ibm.com/iam/apikeys
IBM_API_KEY=your_ibm_cloud_api_key_here

# IBM watsonx.ai Project ID
# Get from: https://dataplatform.cloud.ibm.com → Your Project → Manage → General
# IMPORTANT: The project must have a Watson Machine Learning instance associated.
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# IBM watsonx.ai API Base URL (choose your region)
# Dallas   (us-south): https://us-south.ml.cloud.ibm.com
# Frankfurt (eu-de):   https://eu-de.ml.cloud.ibm.com
# London    (eu-gb):   https://eu-gb.ml.cloud.ibm.com
# Tokyo     (jp-tok):  https://jp-tok.ml.cloud.ibm.com
WATSONX_BASE_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite Model ID (use the model available on your account)
# Check available models at: https://cloud.ibm.com/apidocs/watsonx-ai#text-chat
GRANITE_MODEL_ID=ibm/granite-4-h-small

# IAM Token Endpoint (do not change)
IBM_IAM_URL=https://iam.cloud.ibm.com/identity/token

# Server Configuration
PORT=3000
NODE_ENV=development
